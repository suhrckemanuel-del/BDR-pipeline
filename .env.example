# Copy this file to .env and fill in your keys. .env is gitignored and never committed.

# ─── Required ─────────────────────────────────────────────────────────────────

# Anthropic — https://console.anthropic.com/settings/api-keys
# Used by every agent (enrichment, strategist, humanizer, critic).
ANTHROPIC_API_KEY=

# Exa — https://exa.ai/api
# Used by enrichment for live news + job-posting signals. Pipeline still runs
# without it (just fewer signals).
EXA_API_KEY=

# Hunter.io — https://hunter.io/api-documentation
# Used by enrichment for contact discovery on the prospect's domain. Pipeline
# still runs without it (sequence drops the named-contact personalization).
HUNTER_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────────

# Notion — https://www.notion.so/my-integrations
# Required only if you enable CRM sync (crm.enabled: true in tenant config.yaml).
NOTION_API_KEY=
NOTION_DATABASE_ID=

# HubSpot — private-app access token (Settings → Integrations → Private Apps).
# Required only if a tenant sets crm.provider: hubspot. Free CRM tier is enough
# (scopes: crm.objects.companies/contacts/notes read+write).
HUBSPOT_ACCESS_TOKEN=

# Salesforce — required only if a tenant sets crm.provider: salesforce.
# Access token: a connected-app OAuth token or `sf org display --json` from the
# Salesforce CLI. Instance URL is your org's URL (e.g. https://acme.my.salesforce.com).
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=

# Pipedrive — required only if a tenant sets crm.provider: pipedrive.
# Personal API token: Pipedrive → Settings → Personal preferences → API.
PIPEDRIVE_API_TOKEN=

# Instantly — required only for live push (tenant outreach.instantly_campaign_id set).
# API key: Instantly → Settings → Integrations → API Keys (v2 key).
INSTANTLY_API_KEY=

# Smartlead — required only for live push (tenant outreach.smartlead_campaign_id set).
# API key: Smartlead → Settings → API Key.
SMARTLEAD_API_KEY=

# Gmail — required only if you use scripts/send_via_gmail.py to send queued sequences.
# Create an App Password at myaccount.google.com/apppasswords (requires 2FA).
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# ─── Safety switches ─────────────────────────────────────────────────────────

# Set to 1 to build CRM / sending-tool payloads without any HTTP calls.
# Recommended for the first live test of a new tenant or key.
# BDR_CRM_DRY_RUN=1
# BDR_PUSH_DRY_RUN=1

# Override the SQLite store location (default: pipeline/bdr.db).
# BDR_DB_PATH=

# ─── Tenant pinning ──────────────────────────────────────────────────────────

# Pin a tenant for Streamlit / scripted runs. When set, the sidebar dropdown
# is disabled. Leave empty to pick from the dropdown each time.
BDR_TENANT=

# ─── LangSmith tracing (optional) ────────────────────────────────────────────

# Uncomment to send traces to LangSmith. Useful for debugging multi-node runs.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=bdr-pipeline
